style.
  #community-users {
    padding: 20px;
    max-width: 800px;
    margin: 0 auto;
  }
  #community-users h3 {
    margin-top: 30px;
    border-bottom: 1px solid var(--bg-secondary);
    padding-bottom: 8px;
  }
  .user-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid var(--bg-secondary);
  }
  .user-row .actions button {
    margin-left: 8px;
    padding: 4px 8px;
    background: var(--bg-secondary);
    border: none;
    border-radius: 4px;
    cursor: pointer;
    color: var(--text);
  }
  .user-row .actions button:hover {
    background: var(--bg-secondary-hover);
  }
  .empty {
    padding: 20px 0;
    color: var(--text-secondary);
    font-style: italic;
  }

div
  h1 User Management
  
  h3 Moderators
  div#moderators-list
  
  h3 Subscribers
  div#subscribers-list
  
  h3 Banned Users
  div#banned-list

script.
  lazyload('/pages/community-users.js', document.currentScript.closest('soci-route'))
